# Sparky API the web app talks to (server-side only)
SPARKY_API_URL=https://sparky.cloudnsofts.com
# Public origin of this app; set it in production behind a proxy (also the allow-listed GitHub sign-in return origin)
APP_ORIGIN=
# Defaults to true when NODE_ENV=production; set false to run `pnpm start` over plain http
SESSION_COOKIE_SECURE=
