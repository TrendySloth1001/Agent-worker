<?xml version="1.0" encoding="utf-8"?>
<!-- Release network policy: HTTPS only, system trust store. No certificate pinning on purpose
     (Cloudflare rotates its certificates; a pin would lock users out without warning). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
