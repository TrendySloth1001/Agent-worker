# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local backend address and token
env.json

# Release signing (never commit): upload keystore + its passwords.
/android/key.properties
/android/app/upload-keystore.jks
test/failures/
android/app/src/debug/*
# The debug-only network security config (cleartext to the dev machine) is tracked.
!android/app/src/debug/res/
android/app/src/profile/
README.md
