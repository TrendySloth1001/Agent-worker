{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migrate:create": "prisma migrate dev --create-only",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@notionhq/client": "^5.27.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "docx": "^9.9.0",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.2.0",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "p-limit": "^7.3.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "tinyld": "^1.3.4",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
