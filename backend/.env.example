PORT=3000
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
DATABASE_URL=postgres://agent:CHANGE_ME@localhost:5433/agentworker
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64
RAG_MIN_SIM=0.30
CHAT_RECALL_MIN_SIM=0.50
RAG_TOP_K=6
GITHUB_TOKEN=
# Per-user "Connect GitHub" (OAuth device flow). Client ID of a GitHub OAuth app
# with "Enable Device Flow" checked; the secret is optional (only used to revoke
# tokens on GitHub when a user disconnects).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public origin of this server (no trailing slash). "Continue with / Connect GitHub"
# uses the OAuth web flow, whose callback is <PUBLIC_BASE_URL>/auth/github/callback:
# set exactly that as the OAuth app's "Authorization callback URL". The web flow
# needs GITHUB_OAUTH_CLIENT_SECRET; without it the app falls back to the device flow.
PUBLIC_BASE_URL=https://sparky.cloudnsofts.com
# 32-byte key, base64 (openssl rand -base64 32), encrypts connection tokens at rest.
CONNECTIONS_KEY=
# 32-byte master key (base64 or 64 hex chars; openssl rand -base64 32) that wraps each user's data key,
# which encrypts chats, memory, knowledge base, documents and uploaded files at rest. REQUIRED in
# production (the server refuses to start without it). Back it up: losing it makes the data unreadable.
# Unset in development: a dev-only derived key is used, with a warning.
DATA_KEY=
# Only while rotating DATA_KEY: the old key(s), comma-separated, so existing data keys can still be unwrapped.
DATA_KEY_PREVIOUS=
# "Continue with Google": Client ID of a Google Cloud OAuth client of type
# "Web application" (the app passes it as serverClientId; it is the ID token's
# audience). Empty hides the button. The same client (with its secret) powers
# Apps → Google Drive: add <PUBLIC_BASE_URL>/connect/google_drive/callback as an
# authorized redirect URI. Without the secret Drive shows "Not set up".
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Optional browser API key for the Google Picker ("Pick files from Drive").
GOOGLE_PICKER_API_KEY=
# Optional Notion public integration (redirect URI <PUBLIC_BASE_URL>/connect/notion/callback).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
STACKEXCHANGE_KEY=
# Optional web search: Brave Search API key (free tier) used as the first web engine;
# without it the keyless engines (DuckDuckGo, Brave's public results page) are used.
BRAVE_SEARCH_API_KEY=
# Optional comma-separated web search providers to switch off, e.g. "brave-html,bingnews".
WEB_SEARCH_DISABLE=
OLLAMA_MONTHLY_REQUEST_BUDGET=
API_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Bearer token for scripts/publish-apk.sh (uploads a release APK); empty disables it
RELEASE_TOKEN=
